{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "paths": {
      "@core/*": ["../core/*"]
    }
  },
  "include": ["**/*.d.ts", "**/*.ts", "**/*.js", "**/*.svelte"]
}
