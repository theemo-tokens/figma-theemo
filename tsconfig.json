{
  "compilerOptions": {
    "target": "es6",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ScriptHost",
      "ES6",
      "ES2016",
      "ES2017",
      "ES2018",
      "ES2019",
      "ES2020"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": false,
    "typeRoots": ["node_modules/@types"],
    "paths": {
      "@core/*": ["./src/core/*"]
    }
  },
  "include": ["src/core/**/*", "src/plugin/**/*", "tests/plugin/**/*"]
}
