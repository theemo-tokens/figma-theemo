{
  "name": "@theemo-figma/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "lint": "pnpm run '/^lint:(js|types)$/'",
    "lint:fix": "pnpm run '/^lint:.*:fix$/'",
    "lint:js": "oxlint .",
    "lint:js:fix": "oxlint . --fix",
    "lint:types": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@figma/plugin-typings": "catalog:lib",
    "@sveltejs/vite-plugin-svelte": "catalog:frontend",
    "@testing-library/svelte": "catalog:test",
    "@theemo-figma/core": "workspace:../core",
    "@tsconfig/svelte": "catalog:frontend",
    "colord": "catalog:lib",
    "figma-ui3-kit-svelte": "catalog:lib",
    "jsdom": "catalog:test",
    "makeup-listbox": "catalog:lib",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "svelte": "catalog:frontend",
    "svelte-check": "catalog:frontend",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-singlefile": "catalog:build",
    "vite-plugin-svgo": "catalog:build",
    "vitest": "catalog:test"
  }
}
